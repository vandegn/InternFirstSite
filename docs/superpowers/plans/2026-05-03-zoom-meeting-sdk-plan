## Phase 6 — ZoomMeetingRoom Component

**New file:** `app/src/components/ZoomMeetingRoom.tsx`

Uses Zoom Meeting SDK **component view** (embedded, not full-page takeover).

```tsx
'use client';
// Dynamic import required — Zoom SDK accesses browser globals
```

Install: `npm install @zoom/meetingsdk` (run from `app/`)

Component receives: `{ meetingNumber, signature, sdkKey, userName, userEmail, zak?, onLeave }`

```tsx
import { useEffect, useRef } from 'react'

export default function ZoomMeetingRoom({ meetingNumber, signature, sdkKey, userName, userEmail, zak, onLeave }) {
  const containerRef = useRef<HTMLDivElement>(null)

  useEffect(() => {
    let client: ReturnType<typeof import('@zoom/meetingsdk/embedded').default.createClient>

    async function init() {
      const ZoomMtgEmbedded = (await import('@zoom/meetingsdk/embedded')).default
      client = ZoomMtgEmbedded.createClient()
      await client.init({
        zoomAppRoot: containerRef.current!,
        language: 'en-US',
      })
      await client.join({
        signature,
        sdkKey,
        meetingNumber,
        password: '',
        userName,
        userEmail,
        zak: zak ?? '',
      })
      client.on('connection-change', (payload) => {
        if (payload.state === 'Closed') onLeave()
      })
    }

    init().catch(console.error)
    return () => { client?.leaveMeeting() }
  }, [])

  return <div ref={containerRef} id="meetingSDKElement" style={{ width: '100%', height: 600 }} />
}
```

The `onLeave` callback in the meeting room page triggers the completion + redirect logic.

